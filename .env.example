# Copy to .env and fill in. .env is gitignored: never commit it.

# Zetaris (local Docker stack): the web app address; the client signs in and queries through it
ZETARIS_URL=http://localhost:3000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me

# OpenCelliD (free account at https://opencellid.org, "Tokens" page)
OPENCELLID_TOKEN=

# Ofcom API (postcode-level coverage; optional until the key arrives)
OFCOM_API_KEY=

# true = live sources (geocode, weather, floods) answer from data/samples/ only
SAMPLE_MODE=false

# Agents: NVIDIA Nemotron via the OpenAI-compatible API (build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b

# Meterless service (agent memory); python run.py starts it
MEMORY_URL=http://127.0.0.1:8100
